{
  "name": "retro-launcher",
  "version": "1.0.0",
  "description": "A retro game launcher with gamepad support and emulator integration",
  "desktopName": "retro-launcher",
  "author": {
    "name": "Gramodrana",
    "email": "gramodrana1@gmail.com"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@31.7.7": true
  },
  "build": {
    "appId": "com.retrolauncher.app",
    "productName": "Retro Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Game",
      "maintainer": "Gramodrana <gramodrana1@gmail.com>",
      "synopsis": "Retro game launcher",
      "description": "A retro game launcher with gamepad support and emulator integration"
    }
  }
}
