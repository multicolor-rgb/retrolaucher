{
  "name": "retro-launcher",
  "version": "2.2.0",
  "description": "A retro game launcher with gamepad support and emulator integration",
  "desktopName": "retro-launcher",
  "author": {
    "name": "Gramodrana",
    "email": "gramodrana1@gmail.com"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "tauri": "tauri",
    "dev": "tauri dev",
    "dist": "tauri build -b deb,appimage",
    "dist:deb": "tauri build -b deb",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "tauri build -b deb,appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "electron": "^43.2.0",
    "electron-builder": "^20.23.1"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@31.7.7": true,
    "@tauri-apps/cli": true
  },
  "build": {
    "appId": "com.retrolauncher.app",
    "productName": "Retro Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/linux/icons",
      "category": "Game",
      "maintainer": "Gramodrana <gramodrana1@gmail.com>",
      "synopsis": "Retro game launcher",
      "description": "A retro game launcher with gamepad support and emulator integration"
    }
  }
}
