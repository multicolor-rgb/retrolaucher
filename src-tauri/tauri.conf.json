{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "retro-launcher",
  "version": "2.2.0",
  "identifier": "retro-launcher",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Retro Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#05060a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPCONFIG/**/*",
            "$APPDATA/**/*",
            "$APPLOCALDATA/**/*",
            "$HOME/**/*",
            "$TEMP/**/*",
            "/media/**/*",
            "/mnt/**/*",
            "/run/media/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Game",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0"
        ],
        "section": "games"
      }
    }
  }
}
